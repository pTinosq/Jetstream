# Drizzle
DATABASE_URL=local.db

# Flight auto-detect (optional). Prefer configuring these in the app's Settings
# page (stored in the DB) — no .env needed. These env vars are a fallback for
# env-based deploys; DB settings take precedence. Free account + API client:
# https://opensky-network.org/
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
