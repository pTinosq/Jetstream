# Drizzle
DATABASE_URL=local.db

# Flight auto-detect (optional). Prefer configuring these in the app's Settings
# page (stored in the DB) — no .env needed. These env vars are a fallback for
# env-based deploys; DB settings take precedence. Free account + API client:
# https://opensky-network.org/
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# AI flight assistant (optional). Turn free text / a booking email into a
# prefilled flight. Prefer the in-app Settings page; these are a fallback for
# env-based deploys (DB settings take precedence). Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any tool-calling model on OpenRouter; defaults to deepseek/deepseek-v4.1-flash.
OPENROUTER_MODEL=
